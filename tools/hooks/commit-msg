#!/bin/bash
#
# Commit message validation hook
# Enforces conventional commit format
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Ignore merge commits
if echo "$COMMIT_MSG" | grep -qE "^Merge"; then
    exit 0
fi

# Conventional commit pattern: <type>(<scope>): <subject>
# Examples:
#   feat(api): Add new endpoint
#   fix(auth): Fix login bug
#   docs: Update README

PATTERN="^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\(.+\))?: .{1,100}"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo -e "${RED}❌ Invalid commit message format!${NC}"
    echo ""
    echo -e "${YELLOW}Commit message must follow conventional commits:${NC}"
    echo ""
    echo "  <type>(<scope>): <subject>"
    echo ""
    echo "Types:"
    echo "  feat     - New feature"
    echo "  fix      - Bug fix"
    echo "  docs     - Documentation"
    echo "  style    - Formatting"
    echo "  refactor - Code restructuring"
    echo "  perf     - Performance improvement"
    echo "  test     - Adding tests"
    echo "  chore    - Maintenance"
    echo "  ci       - CI/CD changes"
    echo ""
    echo "Examples:"
    echo "  feat(api): Add user authentication"
    echo "  fix(db): Repair connection leak"
    echo "  docs: Update installation guide"
    echo ""
    echo -e "${RED}Your message:${NC}"
    echo "  $COMMIT_MSG"
    echo ""
    exit 1
fi

echo -e "${GREEN}✓ Commit message format valid${NC}"
exit 0

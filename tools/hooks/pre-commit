#!/bin/bash
#
# Pre-commit hook for SuhLabs repositories
# Prevents committing secrets and validates code quality
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🔍 Running pre-commit checks..."

# Check 1: Detect secrets
echo "  → Checking for secrets..."
if git diff --cached | grep -iE 'password\s*=|secret\s*=|api[_-]?key|private[_-]?key|BEGIN (RSA|EC|OPENSSH) PRIVATE KEY'; then
    echo -e "${RED}❌ ERROR: Potential secret detected in staged files!${NC}"
    echo -e "${YELLOW}Please remove secrets before committing.${NC}"
    echo -e "${YELLOW}Use environment variables or Vault instead.${NC}"
    exit 1
fi
echo -e "${GREEN}  ✓ No secrets detected${NC}"

# Check 2: Validate shell scripts (if shellcheck is installed)
if command -v shellcheck &> /dev/null; then
    echo "  → Running ShellCheck on scripts..."
    SHELL_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.sh$' || true)
    
    if [ -n "$SHELL_FILES" ]; then
        for file in $SHELL_FILES; do
            if [ -f "$file" ]; then
                if ! shellcheck "$file"; then
                    echo -e "${RED}❌ ShellCheck failed for: $file${NC}"
                    exit 1
                fi
            fi
        done
        echo -e "${GREEN}  ✓ ShellCheck passed${NC}"
    fi
else
    echo -e "${YELLOW}  ⚠ ShellCheck not installed (run: apt install shellcheck)${NC}"
fi

# Check 3: Prevent committing to main without review (optional)
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
    echo -e "${YELLOW}⚠ Committing directly to $BRANCH${NC}"
    echo -e "${YELLOW}Consider using feature branches for better workflow.${NC}"
fi

# Check 4: Verify no large files
echo "  → Checking for large files..."
MAX_SIZE=5242880  # 5MB in bytes
LARGE_FILES=$(git diff --cached --name-only --diff-filter=ACM | while read file; do
    if [ -f "$file" ]; then
        size=$(wc -c < "$file")
        if [ "$size" -gt "$MAX_SIZE" ]; then
            echo "$file ($((size / 1024 / 1024))MB)"
        fi
    fi
done)

if [ -n "$LARGE_FILES" ]; then
    echo -e "${YELLOW}⚠ Warning: Large files detected:${NC}"
    echo "$LARGE_FILES"
    echo -e "${YELLOW}Consider using Git LFS for large files.${NC}"
fi

# Check 5: Verify commit message format (if committing)
# This runs in commit-msg hook, not pre-commit

echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
exit 0
